# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used exclusively by scripts/create-admin.ts. Do not add a
# NEXT_PUBLIC_ prefix to this, and never reference it from client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: absolute site URL, used to render a copyable join link in the
# admin session control panel. Falls back to a relative /join/... link if
# unset.
NEXT_PUBLIC_SITE_URL=
